# Copy to .env and adjust. Mount the CIFS share before starting (the directories are
# bind-mounted; if the share is missing the vehicle list is simply empty).

# Transformed PCDs (<uuid>.pcd + optional <uuid>.transform.json) — mounted read-only
PCD_DIR=/mnt/share/pcd
# Prelabel files written by the prelabeler (<uuid>.prelabel.json) — mounted read-only
PRELABEL_DIR=/mnt/share/prelabels
# Label files written by axel-labler (<uuid>.axles.json)
LABELS_DIR=/mnt/share/labels
# Exports (one timestamped folder per export)
EXPORT_DIR=/mnt/share/export

# Where the web UI is published. 127.0.0.1 = this machine only. Use 0.0.0.0 (or a LAN address)
# only inside a secured network: there is no authentication.
BIND_ADDR=127.0.0.1
PORT=8080

# Ground-truth gap tolerance (m) and the maximum wheel-set depth for the automatic fit (m)
GT_TOLERANCE_M=0.10
MAX_DEPTH_M=0.8
